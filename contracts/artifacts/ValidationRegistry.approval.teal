    frame_dig -5
    btoi
    bz _check_fallback_after_if_else@2
    // contracts/validation_registry.py:468
    // assert fallback != primary, "the fallback must differ from the validator"
    frame_dig -5
    frame_dig -4
    b!=
    assert // the fallback must differ from the validator
    // contracts/validation_registry.py:469
    // assert fallback != server, "the worker cannot be their own fallback judge"
    frame_dig -5
    frame_dig -3
    b!=
    assert // the worker cannot be their own fallback judge
    // contracts/validation_registry.py:470
    // fb_addr = self._agent_address(fallback)
    frame_dig -5
    callsub _agent_address
    // contracts/validation_registry.py:471
    // assert fb_addr != client, "the client cannot be the fallback judge"
    dup
    frame_dig -2
    !=
    assert // the client cannot be the fallback judge
    // contracts/validation_registry.py:472
    // assert fb_addr != server_addr, "the worker cannot be the fallback judge"
    frame_dig -1
    !=
    assert // the worker cannot be the fallback judge

_check_fallback_after_if_else@2:
    retsub


