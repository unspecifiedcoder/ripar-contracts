    // app = Global.current_application_address
    global CurrentApplicationAddress
    // contracts/validation_registry.py:232
    // assert mbr.receiver == app, "storage payment must be sent to this app"
    frame_dig -2
    gtxns Receiver
    dig 1
    ==
    assert // storage payment must be sent to this app
    // contracts/validation_registry.py:233
    // assert mbr.sender == Txn.sender, "you must pay for the storage you create"
    frame_dig -2
    gtxns Sender
    txn Sender
    ==
    assert // you must pay for the storage you create
    // contracts/validation_registry.py:235
    // mbr.amount >= app.min_balance - before
    frame_dig -2
    gtxns Amount
    swap
    acct_params_get AcctMinBalance
    assert // account funded
    frame_dig -1
    -
    >=
    // contracts/validation_registry.py:234-236
    // assert (
    //     mbr.amount >= app.min_balance - before
    // ), "payment must cover the box storage this call adds"
    assert // payment must cover the box storage this call adds
    retsub


// validation_registry.ValidationRegistry._check_fallback(fallback: bytes, primary: bytes, server: bytes, client: bytes, server_addr: bytes) -> void:
_check_fallback:
    // contracts/validation_registry.py:448-456
