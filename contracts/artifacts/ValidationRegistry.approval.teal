// validation_registry.ValidationRegistry._assert_covers_box_growth(mbr: uint64, before: uint64) -> void:
_assert_covers_box_growth:
    // contracts/validation_registry.py:222-223
    // @subroutine
    // def _assert_covers_box_growth(self, mbr: gtxn.PaymentTransaction, before: UInt64) -> None:
    proto 2 0
